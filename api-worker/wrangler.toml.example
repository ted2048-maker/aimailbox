name = "aimailbox-api-worker"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# D1 database binding
# Run: wrangler d1 create aimailbox-db
# Then replace YOUR_D1_DATABASE_ID with the actual ID
[[d1_databases]]
binding = "DB"
database_name = "aimailbox-db"
database_id = "YOUR_D1_DATABASE_ID"

[vars]
DOMAIN = "your-domain.dev"
INBOX_ID_LENGTH = 6

# Custom domain routing (optional)
# routes = [
#   { pattern = "api.your-domain.dev/*", zone_name = "your-domain.dev" }
# ]
