name = "aimailbox-api-worker"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# KV namespace binding
# Run: wrangler kv namespace create "INBOX_KV"
# Then replace YOUR_KV_NAMESPACE_ID with the actual ID
[[kv_namespaces]]
binding = "INBOX_KV"
id = "YOUR_KV_NAMESPACE_ID"

[vars]
DOMAIN = "your-domain.dev"
INBOX_ID_LENGTH = 6

# Custom domain routing (optional)
# routes = [
#   { pattern = "api.your-domain.dev/*", zone_name = "your-domain.dev" }
# ]
