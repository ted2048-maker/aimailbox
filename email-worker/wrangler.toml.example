name = "aimailbox-email-worker"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# D1 database binding - must be the same as api-worker
# Run: wrangler d1 create aimailbox-db
# Then replace YOUR_D1_DATABASE_ID with the actual ID
[[d1_databases]]
binding = "DB"
database_name = "aimailbox-db"
database_id = "YOUR_D1_DATABASE_ID"

[vars]
DOMAIN = "your-domain.dev"

# Email routing is configured in Cloudflare Dashboard:
# 1. Enable Email Routing for your domain
# 2. Set Catch-all -> Send to this Worker
